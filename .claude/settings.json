{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-portfolio-data.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python -c:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)"
    ],
    "ask": [
      "Bash(uv run python -m jobs.run_advise:*)",
      "Bash(uv run python -m jobs.run_evaluate:*)",
      "Bash(uv run python -m jobs.run_ingest:*)",
      "Bash(uv run python -m jobs.run_reflect:*)",
      "Bash(uv run python -m jobs.apply_migrations:*)",
      "Bash(uv run python -m jobs.ingest_portfolio:*)",
      "Bash(uv run python -m jobs.ingest_knowledge:*)",
      "Bash(uv run python -m jobs.show_report:*)",
      "Bash(uv run python -m jobs.show_costs:*)",
      "Bash(npm run dev:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Read(./knowledge/**)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)"
    ]
  }
}
