# ── Quant PM 환경변수 목록 ────────────────────────────────────────────────
# 실제 값은 이 파일을 .env로 복사해 채운다. .env는 gitignore되어 절대
# 커밋되지 않는다. 이 리포는 공개이므로 비밀값은 어떤 파일·로그·채팅에도
# 붙여넣지 않는다.
#
# 같은 변수를 세 곳에 나눠 관리한다:
#   1) 로컬 .env         — 포트폴리오/지식 CLI 실행용 (본인 PC)
#   2) claude.ai 환경 설정 — 매일 자동 실행(Routine)용
#   3) Vercel 프로젝트     — 대시보드용 (NEXT_PUBLIC_* 두 개만)

# [필수] Supabase Postgres 접속 문자열.
# Supabase → Project Settings → Database → "Session pooler" URI를 쓸 것.
# (Direct connection은 IPv6 전용이라 실행 환경에 따라 연결이 안 된다.)
SUPABASE_DB_URL=

# [선택] 보유 종목 외에 분석할 관찰 종목. 쉼표 구분.
WATCHLIST=NVDA,TSLA

# [선택] LLM 결제 경로. claude_cli = Claude 구독(quota)으로 결제, 헤드리스
# Claude Code 필요. 미설정(api) = ANTHROPIC_API_KEY로 토큰당 과금.
LLM_TRANSPORT=claude_cli

# [LLM_TRANSPORT=api일 때만 필수]
ANTHROPIC_API_KEY=

# [선택] 모델 오버라이드. 기본 claude-sonnet-5.
# MODEL_ID=

# [선택] 일일 리포트 이메일 발송 (Resend).
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# [선택] 파이프라인 스위치. 기본 전부 켜짐.
# MEMORY_ENABLED=1
# MEMORY_SHORT_TERM_SESSIONS=8
# NEWS_ENABLED=1

# ── 대시보드(Vercel) 전용 ─────────────────────────────────────────────────
# Supabase → Project Settings → API. anon key는 RLS 아래에서만 안전하므로
# RLS 정책을 켜기 전에는 대시보드를 샘플 데이터 모드로 둘 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
